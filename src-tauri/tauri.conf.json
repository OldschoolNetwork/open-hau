{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHaU",
  "version": "26.2.5",
  "identifier": "app.openhau.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenHaU \u00b7 26.2",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "icons/database.ico": "database.ico",
      "../resources/OpenHaU-Quick-Start.html": "OpenHaU-Quick-Start.html",
      "../resources/OpenHaU-API.mjs": "OpenHaU-API.mjs",
      "../docs/database-api.md": "docs/database-api.md",
      "../docs/data-format.md": "docs/data-format.md",
      "../docs/openhau-v4.schema.json": "docs/openhau-v4.schema.json",
      "../docs/personal-accounts.md": "docs/personal-accounts.md",
      "../docs/group-payments.md": "docs/group-payments.md",
      "../docs/registers.md": "docs/registers.md",
      "../docs/administration.md": "docs/administration.md"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.6"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": true,
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "description": "OpenHaU Database",
        "mimeType": "application/vnd.openhau.database+json",
        "rank": "Alternate",
        "name": "OpenHaU Database",
        "exportedType": {
          "conformsTo": [
            "public.json",
            "public.database"
          ],
          "identifier": "app.openhau.database"
        },
        "ext": [
          "odb"
        ],
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5OUE0Q0Q4RjU1REFDNzIKUldSeXJGMzEyRXlhNlpJWEFEUTRGcXo5cWFoSHM2bjdkclRHV054ckhQVmE1VmRKRW5qL0c0NVoK",
      "endpoints": [
        "https://github.com/OldschoolNetwork/open-hau/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
