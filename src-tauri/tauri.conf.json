  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],"macOS":{"minimumSystemVersion":"12.6"},"windows":{"nsis":{"displayLanguageSelector":true,"languages":["Russian","English"]}}}
