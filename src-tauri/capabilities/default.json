{
  "identifier": "main-capability",
  "description": "Local desktop files selected by the user",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
